# Non-secret configuration. Load explicitly: source examples/deepseek.env.example
# Configure OPENAI_API_KEY separately through your environment's Secrets.
export MODEL_PROVIDER=openai
export OPENAI_BASE_URL=https://api.deepseek.com
export MODEL_NAME=deepseek-flash
# Keep the short JSON responses within the POC output budget.
export MODEL_THINKING=disabled
# Verified 2026-10-12: peak, cache-miss USD per million tokens (conservative).
# https://api-docs.deepseek.com/quick_start/pricing/
export MODEL_INPUT_USD_PER_MILLION=0.30
export MODEL_OUTPUT_USD_PER_MILLION=1.20
